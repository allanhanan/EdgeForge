# EdgeForge Environment Configuration
# Meta Global AI Developer Hackathon 2026

# Meta AI / LLM Configuration
# Optional: Set META_API_KEY to connect to live Meta Model API (Muse Spark / LLaMA)
# Leave empty to operate in zero-cost offline deterministic development mode
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-v1
AGENT_OFFLINE_MODE=true

# Server Settings
PROJECT_NAME=EdgeForge
API_V1_STR=/api/v1
DEBUG=true

# Database Settings
DATABASE_URL=sqlite+aiosqlite:///backend/storage/edgeforge.db
